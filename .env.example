# Copy this file to .env.local and fill in the real values.
# Never commit .env.local. Ask the maintainer for the keys privately.

# ── This repo's shared settings (safe defaults, no secrets) ───────────────────
# Public base URL of the site, used for canonical URLs, the sitemap, robots.txt,
# the web manifest and Open Graph/Twitter previews. Include no trailing slash.
# Safe default for local development; set to the production URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How the frontend talks to the backend: "mock" (default) or "live".
#   mock — no network traffic. The register and contact forms wait briefly and
#          resolve with a successful, obviously-fake response.
#   live — forms POST JSON to the backend at /api/register and /api/contact.
# The frontend never sends the college ID file; upload is owned by the backend.
NEXT_PUBLIC_API_MODE=mock

# ── Backend-owned variables (not read by anything in this repo today) ─────────
# The backend teammate will edit this list as needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
